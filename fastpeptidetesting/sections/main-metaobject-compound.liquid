{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .compound-facts {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1fr;
    margin: 2.4rem 0;
  }

  @media screen and (min-width: 750px) {
    .compound-facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .compound-facts dt {
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.65;
    margin: 0 0 0.2rem;
  }

  .compound-facts dd {
    margin: 0 0 1rem;
    font-size: 1.6rem;
    word-break: break-word;
  }

  .compound-sequence {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 1.4rem;
    line-height: 1.5;
    white-space: pre-wrap;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    padding: 1.6rem;
    margin: 1.6rem 0 2.4rem;
  }
{%- endstyle -%}

{%- liquid
  assign brand_name = settings.brand_name | default: shop.name
  assign compound_name = metaobject.name.value
  assign order_collection = collections['order-testing']
-%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <p class="caption-with-letter-spacing">Compound reference</p>
  <h1 class="main-page-title page-title h0">
    {{ compound_name | default: metaobject.system.handle | escape }}
  </h1>
  <p class="rte">
    Analytical reference for {{ compound_name | escape }}. Measurement context only. No dosing or effects language.
  </p>

  <dl class="compound-facts">
    {%- if metaobject.molecular_formula.value != blank -%}
      <div>
        <dt>Molecular formula</dt>
        <dd>{{ metaobject.molecular_formula.value | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if metaobject.monoisotopic_mass.value != blank -%}
      <div>
        <dt>Monoisotopic mass</dt>
        <dd>{{ metaobject.monoisotopic_mass.value | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if metaobject.average_mass.value != blank -%}
      <div>
        <dt>Average mass</dt>
        <dd>{{ metaobject.average_mass.value | escape }}</dd>
      </div>
    {%- endif -%}
    {%- if metaobject.detection_wavelength.value != blank -%}
      <div>
        <dt>Detection wavelength</dt>
        <dd>{{ metaobject.detection_wavelength.value | escape }} nm</dd>
      </div>
    {%- endif -%}
    {%- if metaobject.typical_sample_amount_mg.value != blank -%}
      <div>
        <dt>Typical sample amount</dt>
        <dd>{{ metaobject.typical_sample_amount_mg.value | escape }} mg (lyophilized)</dd>
      </div>
    {%- endif -%}
  </dl>

  {%- if metaobject.sequence.value != blank -%}
    <h2 class="h3">Sequence</h2>
    <div class="compound-sequence">{{ metaobject.sequence.value | escape }}</div>
  {%- endif -%}

  {%- if metaobject.common_synthesis_impurities.value != blank -%}
    <h2 class="h3">Common synthesis impurities</h2>
    <div class="rte">{{ metaobject.common_synthesis_impurities.value }}</div>
  {%- endif -%}

  {%- if metaobject.linked_tests.value != blank and metaobject.linked_tests.value.size > 0 -%}
    <h2 class="h3">Order testing</h2>
    <ul>
      {%- for product in metaobject.linked_tests.value -%}
        <li>
          <a href="{{ product.url }}?compound={{ metaobject.system.handle | url_encode }}">
            {{ product.title | escape }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- elsif order_collection != blank -%}
    <p>
      <a class="button" href="{{ order_collection.url }}">
        Order HPLC test for {{ compound_name | escape }}
      </a>
    </p>
  {%- endif -%}

  <p class="rte" style="margin-top: 3rem;">
    {{ brand_name | escape }} does not sell peptides and holds no stake in any vendor. Results are reported as measured.
  </p>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": {{ compound_name | default: metaobject.system.handle | json }},
  "description": {{ metaobject.seo_description.value | default: page_description | json }},
  "url": {{ request.origin | append: metaobject.system.url | json }},
  "author": {
    "@type": "Organization",
    "name": {{ brand_name | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ brand_name | json }},
    "url": {{ request.origin | json }}
  }
}
</script>

{% schema %}
{
  "name": "Compound page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
