{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{% # theme-check-disable RemoteAsset %}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
  media="print"
  onload="this.media='all'"
>
{% # theme-check-enable RemoteAsset %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .icons-with-content .icon-symbol-wrap {
    margin-bottom: 1.2rem;
  }
{%- endstyle -%}

<div class="multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.title == blank and section.settings.heading == blank %} section-{{ section.id }}-padding{% else %} section-{{ section.id }}-padding{% endunless %}">
  <div class="page-width">
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endunless -%}

    <ul class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop" role="list">
      {%- for block in section.blocks -%}
        <li
          class="multicolumn-list__item grid__item{% if section.blocks.size == 1 %} center{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="multicolumn-card content-container">
            {%- unless block.settings.icon == blank -%}
              <div class="icon-symbol-wrap">
                {% render 'icon-symbol', icon: block.settings.icon, size: '2.8rem' %}
              </div>
            {%- endunless -%}
            {%- unless block.settings.heading == blank -%}
              <h3 class="inline-richtext">{{ block.settings.heading }}</h3>
            {%- endunless -%}
            {%- unless block.settings.text == blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endunless -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Icons with content",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1",
      "label": "Columns on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Material Symbol name",
          "default": "verified",
          "info": "Ligature name from Material Symbols Outlined, e.g. verified, science, local_shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Trust point"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Short factual description.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icons with content",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "verified",
            "heading": "Verified",
            "text": "<p>Batch tested to published specifications.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "science",
            "heading": "Documented",
            "text": "<p>Clear methods and documented results.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "local_shipping",
            "heading": "Reliable",
            "text": "<p>Straightforward fulfilment and communication.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
