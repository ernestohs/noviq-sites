{%- style -%}
  #shopify-section-{{ section.id }} .fpt-final {
    position: relative;
    overflow: hidden;
    color: #fff;
    text-align: center;
    padding: 7.2rem 0;
  }
  #shopify-section-{{ section.id }} .fpt-final__media {
    position: absolute;
    inset: 0;
  }
  #shopify-section-{{ section.id }} .fpt-final__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .fpt-final__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.78);
  }
  #shopify-section-{{ section.id }} .fpt-final__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3rem;
    max-width: 90rem;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .fpt-final__eyebrow {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .fpt-final__title {
    margin: 0;
    font-size: clamp(3.2rem, 4vw, 4.8rem);
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .fpt-final__text {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.45;
    color: #d7e8fa;
  }
  #shopify-section-{{ section.id }} .fpt-final__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem;
  }
{%- endstyle -%}

<section class="fpt-final">
  <div class="fpt-final__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', alt: '' }}
    {%- else -%}
      <img src="{{ 'fpt-final-cta.png' | asset_url }}" alt="" width="1600" height="900" loading="lazy">
    {%- endif -%}
  </div>
  <div class="fpt-page-width fpt-final__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fpt-final__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="fpt-final__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="fpt-final__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="fpt-final__actions">
      {%- if section.settings.primary_label != blank -%}
        <a class="fpt-btn fpt-btn--primary" href="{{ section.settings.primary_link }}">
          {{ section.settings.primary_label | escape }}
          {% render 'fpt-chevron' %}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="fpt-btn fpt-btn--secondary" href="{{ section.settings.secondary_link }}">
          {{ section.settings.secondary_label | escape }}
          {% render 'fpt-chevron' %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FPT final CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Independent testing for a clearer tomorrow"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for clearer answers?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Fast, independent peptide testing. Real results you can verify."
    },
    { "type": "text", "id": "primary_label", "label": "Primary CTA", "default": "Start a Test" },
    { "type": "url", "id": "primary_link", "label": "Primary link", "default": "/products/peptide-testing" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA", "default": "Talk to the Lab" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link", "default": "/pages/contact-us" }
  ],
  "presets": [{ "name": "FPT final CTA" }]
}
{% endschema %}
