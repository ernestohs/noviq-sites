{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .verify-form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-end;
    margin: 2.4rem 0;
  }

  .verify-form__field {
    flex: 1 1 24rem;
  }

  .verify-form__field label {
    display: block;
    margin-bottom: 0.6rem;
  }

  .verify-form__field input {
    width: 100%;
  }

  .verify-note {
    opacity: 0.75;
    font-size: 1.4rem;
  }
{%- endstyle -%}

{%- assign brand_name = settings.brand_name | default: shop.name -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- else -%}
    <div class="rte">
      <p>
        Enter a certificate ID to open the public certificate page for that report.
        Issued by {{ brand_name | escape }}.
      </p>
    </div>
  {%- endif -%}

  <form class="verify-form" id="CertificateVerifyForm" action="/pages/certificates/" method="get">
    <div class="verify-form__field">
      <label for="CertificateId">Certificate ID</label>
      <input
        id="CertificateId"
        name="id"
        type="text"
        required
        autocomplete="off"
        spellcheck="false"
        placeholder="FPT-DEMO-BPC157-001"
        pattern="[A-Za-z0-9._-]+"
      >
    </div>
    <button type="submit" class="button">Verify certificate</button>
  </form>

  <p class="verify-note">
    Certificate URLs use the format
    <code>/pages/certificates/{handle}</code>.
    Enter the certificate ID (Shopify turns it into the public handle).
    Demo example: <code>FPT-DEMO-BPC157-001</code>.
  </p>
</div>

<script>
  (function () {
    var form = document.getElementById('CertificateVerifyForm');
    if (!form) return;

    // Match Shopify Online Store handle rules for certificate IDs:
    // lowercase, hyphen at letter/digit boundaries, collapse other separators.
    function toCertificateHandle(value) {
      return String(value)
        .trim()
        .toLowerCase()
        .replace(/([a-z])(\d)/g, '$1-$2')
        .replace(/(\d)([a-z])/g, '$1-$2')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var input = document.getElementById('CertificateId');
      var raw = (input && input.value ? input.value : '').trim();
      if (!raw) return;
      var handle = toCertificateHandle(raw);
      if (!handle) return;
      window.location.assign('/pages/certificates/' + encodeURIComponent(handle));
    });
  })();
</script>

{% schema %}
{
  "name": "Verify certificate",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
