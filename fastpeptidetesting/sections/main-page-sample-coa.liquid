{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .sample-coa-frame {
    width: 100%;
    min-height: 70vh;
    border: 1px solid rgba(var(--color-foreground), 0.12);
    margin: 2.4rem 0;
  }

  .sample-coa-placeholder {
    border: 1px dashed rgba(var(--color-foreground), 0.25);
    padding: 3rem 2rem;
    text-align: center;
    margin: 2.4rem 0;
  }
{%- endstyle -%}

{%- assign brand_name = settings.brand_name | default: shop.name -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0">{{ page.title | escape }}</h1>

  {%- if page.content != blank -%}
    <div class="rte">{{ page.content }}</div>
  {%- else -%}
    <div class="rte">
      <p>
        Sample peptide certificate of analysis from {{ brand_name | escape }}.
        Shows purity by peak area, chromatogram, peak table, method summary, and verification ID.
      </p>
    </div>
  {%- endif -%}

  {%- if section.settings.sample_pdf_url != blank -%}
    <p>
      <a class="button" href="{{ section.settings.sample_pdf_url }}" target="_blank" rel="noopener">
        Download sample COA (PDF)
      </a>
    </p>
    <iframe
      class="sample-coa-frame"
      title="Sample certificate of analysis PDF"
      src="{{ section.settings.sample_pdf_url }}"
    ></iframe>
  {%- else -%}
    <div class="sample-coa-placeholder">
      <p class="h4">Sample COA PDF not uploaded yet</p>
      <p class="rte">
        In the theme editor, open this section and paste the sample certificate PDF URL
        (Content → Files → copy link).
      </p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Sample COA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Sample file"
    },
    {
      "type": "url",
      "id": "sample_pdf_url",
      "label": "Sample COA PDF URL",
      "info": "Upload the PDF under Content → Files, then paste the file URL here."
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
