{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "heading_size": "h1"
          }
        },
        "price": {
          "type": "price"
        },
        "text_includes": {
          "type": "text",
          "settings": {
            "text": "$199 per vial. Configure peptides, optional screens, and turnaround below.",
            "text_style": "subtitle"
          }
        },
        "peptide_test_configurator": {
          "type": "peptide_test_configurator",
          "settings": {}
        },
        "sample_intake": {
          "type": "sample_intake",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        }
      },
      "block_order": [
        "title",
        "price",
        "text_includes",
        "peptide_test_configurator",
        "sample_intake",
        "buy_buttons",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "none",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": ["main"]
