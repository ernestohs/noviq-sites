    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "faq1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What does the base test include?",
            "icon": "none",
            "row_content": "<p>Purity, potency, and identity as one purchase. Heavy metal, sterility, endotoxin, Karl Fischer moisture, and vial vacuum are optional add-ons or standalone services.</p>",
            "page": ""
          }
        },
        "faq2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I send extra vials from the same lot?",
            "icon": "none",
            "row_content": "<p>Yes. Additional vials must match compound, label claim, manufacturer, and packaging. Differentiated results list each vial on the certificate of analysis. Non-differentiated results combine the lot into one report.</p>",
            "page": ""
          }
        },
        "faq3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What are the turnaround options?",
            "icon": "none",
            "row_content": "<p>Standard is 3 business days, included. 1 business day is +$300. Same day is +$500. Whether the clock starts at payment or at sample receipt is confirmed with the client before launch.</p>",
            "page": ""
          }
        },
        "faq4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need to provide shipping at checkout?",
            "icon": "none",
            "row_content": "<p>No. Testing products are configured as non-physical services. You ship the sample to the lab after you receive the confirmation email.</p>",
            "page": ""
          }
        },
        "faq5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What am I attesting to?",
            "icon": "none",
            "row_content": "<p>Samples are submitted for research and analytical purposes only, not for human or animal use. The certificate of analysis applies only to the tested sample. See the attestation page for the full list.</p>",
            "page": "attestation"
          }
        }
      },
