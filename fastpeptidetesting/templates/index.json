        "step1": {
          "type": "column",
          "settings": {
            "title": "1. Order",
            "text": "<p>Select the compound test, any add-ons, and turnaround. Provide sample details on the product form so they attach to the order.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "step2": {
          "type": "column",
          "settings": {
            "title": "2. Ship sample",
            "text": "<p>After checkout you receive the lab receiving address. Ship the sample with the order number on the package. Do not require a signature.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "step3": {
          "type": "column",
          "settings": {
            "title": "3. Receive report",
            "text": "<p>Results are issued as a certificate of analysis by email. Certificates are delivered only to the customer and are never published publicly.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
