# Copy to .env and fill. Never commit .env.

# Droplet primary IP (SSH/rsync). DNS A record may use a separate reserved/floating IP.
SSH_HOST=example.com
SSH_USER=deploy
SSH_PORT=22
SSH_IDENTITY=
REMOTE_WP_PATH=/var/www/noviqpeptides
WP_CLI=1
WP_ALLOW_ROOT=0

# Resend (production mail). Used by ./configure-resend.sh only — never commit real keys.
RESEND_API_KEY=
RESEND_FROM=support@noviqpeptides.com
RESEND_FROM_NAME=Noviq Peptides

# Paid-order "New order" recipient. Used by ./configure-sales-notifications.sh only.
# Never commit a personal address; leave blank in git.
SALES_NOTIFICATION_EMAIL=
