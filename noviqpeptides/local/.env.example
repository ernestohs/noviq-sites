# Local WordPress for Noviq Peptides. Copy to .env and adjust if needed.
# Never commit .env.

WORDPRESS_PORT=8080
WORDPRESS_TITLE="Noviq Peptides"
WORDPRESS_URL=http://localhost:8080
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=noviq-local-dev
WORDPRESS_ADMIN_EMAIL=admin@example.com

MYSQL_DATABASE=noviqpeptides
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpass

# PayPal Invoicing API (sandbox). Leave blank and configure in WP admin instead.
# Never commit real Client ID/Secret.
PAYPAL_SANDBOX=1
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
